# 키. 이것부터다.
# 한 번 올라가면 커밋 기록에 남아 지워도 안 지워진다.
.env
.env.*
!.env.example

# 사람이 올린 문서. 거래처 자료가 섞일 수 있다.
uploads/

# 만든 이미지. 다시 만들 수 있고 용량이 크다.
images/*
!images/.gitkeep

# 자취 기록. 소재와 근거 원문이 그대로 남는다.
feedback/
choice/
response/

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 편집기·OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 로그와 임시
*.log
nohup.out
*.tmp
*.bak
